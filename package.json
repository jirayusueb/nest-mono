{
  "name": "nest-mono",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "check-types": "vp run -r check-types",
    "test": "bun test apps packages",
    "db:generate": "vp run -r db:generate",
    "db:up": "alchemy deploy packages/infra/src/alchemy.run.ts",
    "destroy": "alchemy destroy packages/infra/src/alchemy.run.ts",
    "deploy": "DEPLOY_APPS=true alchemy deploy packages/infra/src/alchemy.run.ts",
    "lint": "vp lint",
    "fmt": "vp fmt --write",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@oxlint/plugins": "1.83.0",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "oxlint-plugin-comment-reflow": "^0.2.1",
    "typescript": "^5.9.2",
    "vite-plus": "^0.3.3"
  },
  "packageManager": "bun@1.4.2"
}
